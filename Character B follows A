import java.util.*;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        char a = sc.next().charAt(0);
        char b = sc.next().charAt(0);
        
        int count = 0;
        for (int i = 0; i < s.length() - 1; i++) {
            if (s.charAt(i) == a && s.charAt(i + 1) == b) {
                count++;
            }
        }
        System.out.println(count);
    }
}
