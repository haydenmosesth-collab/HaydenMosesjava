import java.util.Scanner;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n1 = sc.nextLong();
        long n2 = sc.nextLong();
        
        long hcf = findHCF(n1, n2);
        long lcm = (n1 * n2) / hcf;
        
        System.out.println(lcm - hcf);
    }
    
    private static long findHCF(long a, long b) {
        while (b != 0) {
            long temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
