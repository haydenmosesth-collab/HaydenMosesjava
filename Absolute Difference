import java.util.*;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int primarySum = 0;
        int secondarySum = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int val = sc.nextInt();
                if (i == j) {
                    primarySum += val;
                }
                if (i + j == n - 1) {
                    secondarySum += val;
                }
            }
        }

        System.out.print(Math.abs(Math.abs(primarySum) - Math.abs(secondarySum)));
    }
}
