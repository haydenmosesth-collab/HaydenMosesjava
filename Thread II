//Thread sleep
class Main {
    public static void main(String[] args) throws Exception {
        for (int i = 0; i < 3; i++) {
            System.out.println("Thread A");
            Thread.sleep(1000);
            System.out.println("Thread B");
            Thread.sleep(1000);
        }
    }
}


//Implementing threads using Runnable
class Main {
    public static void main(String[] args) throws Exception {
        Runnable r1 = () -> System.out.println("Runnable Thread 1");
        Runnable r2 = () -> System.out.println("Runnable Thread 2");

        for (int i = 0; i < 3; i++) {
            r1.run();
            r2.run();
        }
    }
}
