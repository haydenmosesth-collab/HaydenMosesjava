import java.util.*;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt())
            return;
        
        int n = sc.nextInt();
        int m = sc.nextInt();
        
        // Read all N integers
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        
        // Sort the array in ascending order to get the smallest numbers first
        Arrays.sort(arr);
        
        // Calculate the sum of the first M smallest integers
        long minSum = 0;
        for (int i = 0; i < m; i++) {
            minSum += arr[i];
        }
        
        System.out.println(minSum);
    }
}
