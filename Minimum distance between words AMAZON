import java.util.*;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        List<String> tokens = new ArrayList<>();
        
        while (sc.hasNext()) {
            tokens.add(sc.next());
        }
        
        String w2 = tokens.remove(tokens.size() - 1);
        String w1 = tokens.remove(tokens.size() - 1);
        
        int minDistance = Integer.MAX_VALUE;
        
        for (int i = 0; i < tokens.size(); i++) {
            if (tokens.get(i).equals(w1)) {
                for (int j = 0; j < tokens.size(); j++) {
                    if (tokens.get(j).equals(w2)) {
                        // Ensure we don't calculate distance for the exact same token position
                        if (i != j) {
                            int dist = Math.abs(i - j);
                            if (dist < minDistance) {
                                minDistance = dist;
                            }
                        }
                    }
                }
            }
        }
        
        System.out.println(minDistance);
    }
}
