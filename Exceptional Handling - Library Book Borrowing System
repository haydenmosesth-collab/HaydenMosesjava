
import java.util.InputMismatchException;
import java.util.Scanner;

// User-defined exception
class BookNotAvailableException extends Exception {
    BookNotAvailableException(String message) {
        super(message);
    }
}

public class Main {

    // Method using throws
    static void borrowBook(int available, int required)
            throws BookNotAvailableException {

        if (required <= 0) {
            throw new IllegalArgumentException(
                "Number of books must be greater than zero");
        }

        if (required > available) {
            throw new BookNotAvailableException(
                "Not enough books available");
        }

        available = available - required;

        System.out.println("Books borrowed successfully");
        System.out.println("Remaining books: " + available);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        try {
            System.out.print("Enter available books: ");
            int available = sc.nextInt();

            System.out.print("Enter books required: ");
            int required = sc.nextInt();

            if (available < 0) {
                throw new IllegalArgumentException(
                    "Available books cannot be negative");
            }

            borrowBook(available, required);
        }
        catch (InputMismatchException e) {
            System.out.println("Error: Enter integers only");
        }
        catch (IllegalArgumentException e) {
            System.out.println("Error: " + e.getMessage());
        }
        catch (BookNotAvailableException e) {
            System.out.println("Error: " + e.getMessage());
        }
        catch (Exception e) {
            System.out.println("Unexpected error occurred");
        }
        finally {
            System.out.println("Library transaction completed");
            sc.close();
        }
    }
}
