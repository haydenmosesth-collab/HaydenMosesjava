//Creating a Thread
class MyThread extends Thread {
    public void run() {
        System.out.println("Thread is running");
    }
}
class Main {
    public static void main(String[] args) {
        new MyThread().start();
    }
}

//Printing numbers inside a thread
class MyThread extends Thread {
    public void run() {
        System.out.println("Thread:");
        for (int i = 1; i <= 5; i++)
            System.out.println(i);
    }
}
class Main {
    public static void main(String[] args) {
        new MyThread().start();
    }
}
