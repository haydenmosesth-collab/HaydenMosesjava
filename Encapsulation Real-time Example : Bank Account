class BankAccount {
    private double balance; // Hidden data

    // Constructor to initialize balance
    public BankAccount(double initialBalance) {
        if (initialBalance > 0) {
            this.balance = initialBalance;
        }
    }

    // Controlled deposit method
    public void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            System.out.println("Deposited: $" + amount);
        } else {
            System.out.println("Invalid deposit amount!");
        }
    }

    // Controlled withdrawal method with validation
    public void withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            System.out.println("Withdrawn: $" + amount);
        } else {
            System.out.println("Insufficient funds or invalid amount!");
        }
    }

    // Safe read-only access to balance
    public double getBalance() {
        return balance;
    }
}

public class BankApp {
    public static void main(String[] args) {
        BankAccount myAccount = new BankAccount(500.00);
        
        myAccount.deposit(150.00);
        myAccount.withdraw(200.00);
        
        // myAccount.balance = 50000; // Error! Cannot access private field directly.
        
        System.out.println("Current Balance: $" + myAccount.getBalance());
    }
}
