import java.util.*;

public class Hello {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            double price = sc.nextDouble();
            double discountedPrice = price;

            if (price >= 1000) {
                discountedPrice = price * 0.50;
            } else if (price > 500) {
                discountedPrice = price * 0.75;
            } else if (price > 400) {
                discountedPrice = price * 0.80;
            }

            total += discountedPrice;
        }

        if (total > 2000) {
            total -= 100;
        }

        System.out.printf("%.2f\n", total);
    }
}
