public class BasicArray {
    public static void main(String[] args) {
        // 1. Declare and instantiate a 1D array of size 5
        int[] numbers = new int[5];

        // 2. Initialize elements using individual indices (0 to 4)
        numbers[0] = 10;
        numbers[1] = 20;
        numbers[2] = 30;
        numbers[3] = 40;
        numbers[4] = 50;

        // 3. Access and print individual elements
        System.out.println("Element at index 0: " + numbers[0]);
        System.out.println("Element at index 2: " + numbers[2]);
        System.out.println(); // Blank line

        // 4. Traverse the entire array using a standard loop
        System.out.println("Printing all array elements:");
        for (int i = 0; i < numbers.length; i++) {
            System.out.println("Index " + i + " contains: " + numbers[i]);
        }
    }
}
